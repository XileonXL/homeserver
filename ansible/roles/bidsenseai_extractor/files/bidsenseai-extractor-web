#!/usr/bin/env bash
# Update the checkout to origin/<ref>, export the data, build the Astro site and publish it to the web guest.
# The update (fetch, reset, uv sync when a lock file or pyproject changed since the last successful sync) runs under the lock shared with
# the nightly extractor, so a reset never happens under a running extraction. A failed fetch (network)
# or a lock not obtained in time only warns and keeps the current checkout; a failed reset or sync fails.
# Skips the build and publish when the exported data (ignoring generated_at) and the repo commit
# match the last successful publish on the same day (Europe/Madrid).
# Usage: bidsenseai-extractor-web <repo dir> <work dir> <provinces, comma-separated> <ssh key> <known hosts> <user@host> <deploy key> <github known hosts> <ref> <python version> <lock file>
# AWS and database settings come from the environment (systemd EnvironmentFile).
set -euo pipefail

# sha256 of every exported file in sorted path order, with the per-run generated_at removed.
data_fingerprint() {
  /usr/local/bin/uv run --frozen --no-sync python -I -c '
import hashlib, json, pathlib, sys
root = pathlib.Path(sys.argv[1])
digest = hashlib.sha256()
for path in sorted(p for p in root.rglob("*") if p.is_file()):
    data = path.read_bytes()
    if path.suffix == ".json":
        doc = json.loads(data)
        if isinstance(doc, dict):
            doc.pop("generated_at", None)
        data = json.dumps(doc, sort_keys=True).encode()
    digest.update(str(path.relative_to(root)).encode() + b"\0" + data + b"\0")
print(digest.hexdigest())
' "$1"
}

# Fast-forward the checkout to origin/<ref> with the read-only deploy key, as the Ansible git task does.
update_checkout() {
  local repo="$1" key="$2" known_hosts="$3" ref="$4" python="$5" lock="$6" marker="$7"
  local lock_fd new base changed need_sync=1

  # Held until the function returns; the descriptor is closed on every path before the long build.
  exec {lock_fd}>>"${lock}"
  if ! flock --timeout 600 "${lock_fd}"; then
    printf 'warning: lock %s busy, building with the current checkout\n' "${lock}" >&2
    exec {lock_fd}>&-
    return 0
  fi

  if ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -i ${key} -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${known_hosts} -o ConnectTimeout=30" \
    git -C "${repo}" fetch --quiet origin; then
    printf 'warning: git fetch failed, building with the current checkout\n' >&2
    exec {lock_fd}>&-
    return 0
  fi
  git -C "${repo}" reset --hard --quiet "origin/${ref}" || {
    printf '[ERROR] git reset to origin/%s failed in %s\n' "${ref}" "${repo}" >&2
    return 1
  }
  new="$(git -C "${repo}" rev-parse HEAD)"

  # The marker holds the last commit whose sync succeeded, so a failed sync is retried on the next run.
  if [[ -f "${marker}" ]]; then
    base="$(<"${marker}")"
    if git -C "${repo}" cat-file -e "${base}^{commit}" 2>/dev/null; then
      need_sync=0
      changed="$(git -C "${repo}" diff --name-only "${base}" "${new}")"
      if grep -Eq '^uv\.lock$|(^|/)pyproject\.toml$' <<< "${changed}"; then
        need_sync=1
      fi
    fi
  fi
  if [[ "${need_sync}" -eq 1 ]]; then
    (cd -- "${repo}" && /usr/local/bin/uv sync --frozen --no-dev --python "${python}" \
      --package doc-extractor --package adjudication-model) || {
      printf '[ERROR] uv sync failed in %s\n' "${repo}" >&2
      return 1
    }
  fi
  printf '%s\n' "${new}" > "${marker}"
  exec {lock_fd}>&-
}

main() {
  local repo="${1:?usage: ${0##*/} <repo dir> <work dir> <province> <ssh key> <known hosts> <user@host> <deploy key> <github known hosts> <ref> <python version> <lock file>}"
  local work="${2:?missing work dir}"
  local provinces="${3:?missing provinces}"
  local key="${4:?missing ssh key}"
  local known_hosts="${5:?missing known hosts}"
  local target="${6:?missing user@host}"
  local deploy_key="${7:?missing deploy key}"
  local github_known_hosts="${8:?missing github known hosts}"
  local ref="${9:?missing ref}"
  local python="${10:?missing python version}"
  local lock="${11:?missing lock file}"

  local data="${work}/data"
  local -a province_args=()
  local province
  local -a list
  IFS=, read -ra list <<< "${provinces}"
  for province in "${list[@]}"; do
    province_args+=(--province "${province}")
  done
  local release
  release="$(date -u +%Y%m%dT%H%M%SZ)"

  local -a ssh_cmd=(ssh -i "${key}" -o IdentitiesOnly=yes -o BatchMode=yes
    -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=${known_hosts}")

  update_checkout "${repo}" "${deploy_key}" "${github_known_hosts}" "${ref}" "${python}" "${lock}" "${work}/synced.commit"

  rm -rf -- "${data}"
  mkdir -p -- "${data}"
  cd -- "${repo}"
  /usr/local/bin/uv run --frozen --no-sync --package adjudication-model \
    adjudication-model web-export --out "${data}" "${province_args[@]}"

  local fingerprint stamp="${work}/published.stamp"
  # The date is included because the site renders relative dates ("ends tomorrow") at build time.
  fingerprint="$(data_fingerprint "${data}")-$(git -C "${repo}" rev-parse HEAD)-$(TZ=Europe/Madrid date +%F)"
  if [[ -f "${stamp}" && "$(<"${stamp}")" == "${fingerprint}" ]]; then
    printf 'unchanged, skipping build and publish\n'
    return 0
  fi

  # npm never sees the Claude token, and dependency install scripts do not run.
  cd -- "${repo}/web"
  export ASTRO_TELEMETRY_DISABLED=1 BIDSENSE_DATA_DIR="${data}" npm_config_cache="${work}/npm"
  env -u CLAUDE_CODE_OAUTH_TOKEN npm ci --ignore-scripts --no-audit --no-fund
  env -u CLAUDE_CODE_OAUTH_TOKEN npm run build

  # The key only allows write-only rsync into the releases directory and the switch command.
  rsync -rtz --chmod=D755,F644 -e "${ssh_cmd[*]}" dist/ "${target}:${release}/"
  "${ssh_cmd[@]}" "${target}" "switch ${release}"
  printf '%s\n' "${fingerprint}" > "${stamp}"
  printf 'published release %s\n' "${release}"
}

main "$@"
