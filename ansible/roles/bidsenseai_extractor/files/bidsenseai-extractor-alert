#!/usr/bin/env bash
# Send a Telegram message that the extraction failed. Reads TELEGRAM_BOT_TOKEN and
# TELEGRAM_CHAT_ID from the environment (systemd EnvironmentFile).
set -euo pipefail

readonly API_URL="https://api.telegram.org"

main() {
  : "${TELEGRAM_BOT_TOKEN:?TELEGRAM_BOT_TOKEN is not set}"
  : "${TELEGRAM_CHAT_ID:?TELEGRAM_CHAT_ID is not set}"

  local text
  text="$(hostname): bidsenseai-extractor.service failed. Run: journalctl -u bidsenseai-extractor.service -n 100"

  # The token goes to curl on stdin so it never shows in the process list.
  if ! printf 'url = "%s/bot%s/sendMessage"\n' "${API_URL}" "${TELEGRAM_BOT_TOKEN}" \
    | curl --silent --show-error --fail --connect-timeout 5 --max-time 20 --retry 2 \
      --output /dev/null --config - \
      --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
      --data-urlencode "text=${text}"; then
    printf '%s: could not send the Telegram alert\n' "${0##*/}" >&2
    return 1
  fi
}

main "$@"
