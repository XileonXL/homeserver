# {{ ansible_managed }}
[Unit]
Description=BidSense AI document extraction
Wants=network-online.target
After=network-online.target
OnFailure=bidsenseai-extractor-alert@%n.service

[Service]
Type=oneshot
User={{ bidsenseai_extractor_user }}
Group={{ bidsenseai_extractor_user }}
Environment=HOME={{ bidsenseai_extractor_home }}
EnvironmentFile={{ bidsenseai_extractor_config_dir }}/env
WorkingDirectory={{ bidsenseai_extractor_repo_dir }}
ExecStartPre=/usr/bin/install -d -m 0700 {{ bidsenseai_extractor_lock_file | dirname }}
# Update the checkout to the latest pushed ref first; a failure fails the unit. Same lock as the run.
ExecStart=/usr/bin/flock {{ bidsenseai_extractor_lock_file }} /usr/local/sbin/bidsenseai-extractor-update {{ bidsenseai_extractor_repo_dir }} {{ bidsenseai_extractor_home }}/.ssh/deploy_key {{ bidsenseai_extractor_home }}/.ssh/known_hosts {{ bidsenseai_extractor_repo_ref }} {{ bidsenseai_extractor_python_version }} {{ bidsenseai_extractor_home }}/.cache/bidsenseai-lock/synced.commit
ExecStart=/usr/bin/flock {{ bidsenseai_extractor_lock_file }} /usr/local/bin/uv run --frozen --no-sync --package doc-extractor doc-extractor run --pending --limit {{ bidsenseai_extractor_limit }}
TimeoutStartSec={{ bidsenseai_extractor_timeout }}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The update resets the whole checkout (.git, .venv, uv.lock) and uv may install a Python.
ReadWritePaths={{ bidsenseai_extractor_home }}/.cache {{ bidsenseai_extractor_repo_dir }} {{ bidsenseai_extractor_home }}/.local/share/uv
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
UMask=0077
CapabilityBoundingSet=
