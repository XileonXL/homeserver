# {{ ansible_managed }}
AWS_PROFILE="{{ bidsenseai_extractor_aws_profile }}"
AWS_REGION="{{ bidsenseai_extractor_aws_region }}"
AWS_CONFIG_FILE="{{ bidsenseai_extractor_home }}/.aws/config"
DB_CLUSTER_ARN="{{ bidsenseai_extractor_db_cluster_arn }}"
DB_SECRET_ARN="{{ bidsenseai_extractor_db_secret_arn }}"
DB_NAME="{{ bidsenseai_extractor_db_name }}"
BOE_DOCUMENTS_BUCKET="{{ bidsenseai_extractor_documents_bucket }}"
EXTRACTOR_PROVIDER="{{ bidsenseai_extractor_provider }}"
EXTRACTOR_DOC_TYPES="{{ bidsenseai_extractor_doc_types }}"
EXTRACTOR_PROVINCES="{{ bidsenseai_extractor_provinces }}"
EXTRACTOR_CLAUDE_BIN="/usr/local/bin/claude"
DISABLE_AUTOUPDATER="1"
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
CLAUDE_CODE_OAUTH_TOKEN="{{ bidsenseai_extractor_oauth_token }}"
