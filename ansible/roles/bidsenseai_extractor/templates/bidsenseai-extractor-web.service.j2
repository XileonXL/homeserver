# {{ ansible_managed }}
[Unit]
Description=Build the BidSense AI web site and publish it to the web guest
Wants=network-online.target
After=network-online.target
OnFailure=bidsenseai-extractor-alert@%n.service

[Service]
Type=oneshot
User={{ bidsenseai_extractor_user }}
Group={{ bidsenseai_extractor_user }}
Environment=HOME={{ bidsenseai_extractor_home }}
EnvironmentFile={{ bidsenseai_extractor_config_dir }}/env
WorkingDirectory={{ bidsenseai_extractor_repo_dir }}
ExecStartPre=/usr/bin/install -d -m 0700 {{ bidsenseai_extractor_web_work_dir }}
ExecStart=/usr/local/sbin/bidsenseai-extractor-web {{ bidsenseai_extractor_repo_dir }} {{ bidsenseai_extractor_web_work_dir }} {{ bidsenseai_extractor_web_province }} {{ bidsenseai_extractor_web_key_file }} {{ bidsenseai_extractor_web_known_hosts }} {{ bidsenseai_extractor_web_deploy_user }}@{{ bidsenseai_extractor_web_host }}
TimeoutStartSec={{ bidsenseai_extractor_web_timeout }}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# node_modules and dist are written in the checkout's web/.
ReadWritePaths={{ bidsenseai_extractor_home }}/.cache {{ bidsenseai_extractor_repo_dir }}/web
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
UMask=0022
CapabilityBoundingSet=
