# Copy to .env (git-ignored, mode 0600) and load it before running Ansible or
# OpenTofu:  set -a; source .env; set +a
# Use single quotes around values.

# Written by the proxmox_opentofu Ansible role; do not fill in by hand.
PROXMOX_VE_API_TOKEN=''

# Only needed while a node is not yet joined to the tailnet. Create it in the Tailscale
# admin console (Settings, Keys) with a short expiry, pre-authorized, and revoke it
# after the join. For caddy it must be tagged tag:homeserver; the Proxmox host joins
# with an untagged key, so it stays a normal device of yours. Ansible writes it to a
# temporary file on the node, not to the command line.
TAILSCALE_AUTHKEY=''

# Required on the first Pi-hole install; afterwards only to change the password.
PIHOLE_WEB_PASSWORD=''

# Telegram bot token from @BotFather; required by the alerts role.
TELEGRAM_BOT_TOKEN=''

# Chat that receives the alerts. Leave empty: the alerts role finds it from the bot's
# latest message and writes it here.
TELEGRAM_CHAT_ID=''

# Optional dead-man's-switch URL (for example a healthchecks.io check); empty disables the heartbeat.
HEARTBEAT_URL=''

# Stable path of the whole disk that holds the media, as listed in /dev/disk/by-id/ on
# the Proxmox host, for example /dev/disk/by-id/ata-EXAMPLE_DISK_0000000000. It is
# formatted only when it is empty. Empty disables the media_disk role.
MEDIA_DISK=''

# Web UI password of qBittorrent; required on its first install, afterwards only to change it.
QBITTORRENT_PASSWORD=''

# BidSense AI extractor (bidsenseai_extractor role), temporary. Paths are local files on the
# workstation; multi-line secrets are never put in this file.
# Read-only GitHub deploy key (private half) of the BidSense AI repository.
BIDSENSEAI_EXTRACTOR_DEPLOY_KEY_FILE=''
# End-entity certificate and key for IAM Roles Anywhere (extractor.pem, extractor.key).
BIDSENSEAI_EXTRACTOR_CERT_FILE=''
BIDSENSEAI_EXTRACTOR_KEY_FILE=''
# From `tofu output` in the BidSense AI infra/ directory.
BIDSENSEAI_EXTRACTOR_TRUST_ANCHOR_ARN=''
BIDSENSEAI_EXTRACTOR_PROFILE_ARN=''
BIDSENSEAI_EXTRACTOR_ROLE_ARN=''
BIDSENSEAI_EXTRACTOR_DB_CLUSTER_ARN=''
BIDSENSEAI_EXTRACTOR_DB_SECRET_ARN=''
BIDSENSEAI_EXTRACTOR_DB_NAME=''
BIDSENSEAI_EXTRACTOR_DOCUMENTS_BUCKET=''
# Output of `claude setup-token` (Claude Code subscription), valid one year.
CLAUDE_CODE_OAUTH_TOKEN=''

# HireSignal AI (hiresignalai role). The deploy key is a local file on the workstation.
# Private half of the GitHub deploy key of the HireSignal AI repository, with write access
# (the service commits and pushes data/jobs.db).
HIRESIGNALAI_DEPLOY_KEY_FILE=''
# The HireSignal AI Telegram bot (from @BotFather) and its chat; not the house alerts bot above.
# CLAUDE_CODE_OAUTH_TOKEN is shared with the extractor.
HIRESIGNALAI_TELEGRAM_BOT_TOKEN=''
HIRESIGNALAI_TELEGRAM_CHAT_ID=''
# Optional e-mail of the service's git commits; empty uses hiresignalai-bot@users.noreply.github.com.
HIRESIGNALAI_GIT_EMAIL=''
